# Copy to ~/.guardian-sentinel.env on velma, fill in secrets, chmod 600.
# Probes are declared in the JSON config file (SENTINEL_CONFIG); env carries
# ONLY secrets + the config path. See SPEC.md for the full schema.

# --- required ---
# Path to this instance's probe config (internal mode on velma)
SENTINEL_CONFIG=/Users/velma/projects/guardian-sentinel/deploy/internal-config.json
# Full Authorization header value for the Guardian MCP, e.g. "Bearer abc123..."
SENTINEL_MCP_TOKEN=
# Reuse Guardian's existing Telegram bot
TELEGRAM_BOT_TOKEN=
# Your Telegram user id (same value Guardian uses as TELEGRAM_ALLOWED_USER_ID)
TELEGRAM_CHAT_ID=
# Shared secret for the dead-man heartbeat (generate: openssl rand -hex 24;
# must match the value in the DOKS sentinel-secrets Secret)
SENTINEL_HEARTBEAT_TOKEN=

# --- optional ---
# SENTINEL_DRY_RUN=1   # print alerts to stdout instead of sending
