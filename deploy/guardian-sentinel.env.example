# Copy to ~/.guardian-sentinel.env on the host, fill in secrets, chmod 600.
# Everything except the secrets has a sane default baked into the binary —
# uncomment only to override. See SPEC.md for the full table.

# --- secrets (required) ---
# Full Authorization header value for the Guardian MCP, e.g. "Bearer abc123..."
SENTINEL_MCP_TOKEN=
# Reuse Guardian's existing Telegram bot token
TELEGRAM_BOT_TOKEN=
# Your Telegram user id (same value Guardian uses as TELEGRAM_ALLOWED_USER_ID)
TELEGRAM_CHAT_ID=

# --- overrides (optional) ---
# SENTINEL_INTERVAL=60s
# SENTINEL_PROBE_TIMEOUT=10s
# SENTINEL_FAIL_THRESHOLD=3
# SENTINEL_REALERT_COOLDOWN=6h
# SENTINEL_API_URL=http://127.0.0.1:8002/health
# SENTINEL_WEB_URL=http://127.0.0.1:3100/
# SENTINEL_WEB_EXPECT=Guardian
# SENTINEL_MCP_URL=http://127.0.0.1:8765/mcp
# SENTINEL_BACKUP_DIR=/Users/velma/projects/guardian/backups
# SENTINEL_BACKUP_MAX_AGE=26h
# SENTINEL_DRY_RUN=1
