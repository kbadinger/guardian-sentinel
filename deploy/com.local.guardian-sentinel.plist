<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.local.guardian-sentinel</string>

    <!-- Wrapper sources ~/.guardian-sentinel.env (secrets, chmod 600, never
         committed) then execs the binary. Secrets never live in this plist. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/velma/projects/guardian-sentinel/deploy/start-guardian-sentinel.sh</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/velma/Library/Logs/guardian-sentinel.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/velma/Library/Logs/guardian-sentinel.log</string>
</dict>
</plist>
