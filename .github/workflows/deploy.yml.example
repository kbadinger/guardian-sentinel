# Rename to deploy.yml at M7, after the DOKS cluster + registry exist and the
# repo secrets (DO_REGISTRY, DO_KUBECONFIG_B64, DO_API_TOKEN) are configured.
name: deploy

on:
  push:
    branches: [main]

jobs:
  build-push-rollout:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Build and push image
        run: |
          # DO registry: the API token is BOTH username and password
          echo "${{ secrets.DO_API_TOKEN }}" | docker login registry.digitalocean.com -u "${{ secrets.DO_API_TOKEN }}" --password-stdin
          docker build -t registry.digitalocean.com/${{ secrets.DO_REGISTRY }}/guardian-sentinel:${{ github.sha }} .
          docker push registry.digitalocean.com/${{ secrets.DO_REGISTRY }}/guardian-sentinel:${{ github.sha }}
      - name: Rolling update
        run: |
          echo "${{ secrets.DO_KUBECONFIG_B64 }}" | base64 -d > kubeconfig
          KUBECONFIG=./kubeconfig kubectl set image deployment/guardian-sentinel \
            sentinel=registry.digitalocean.com/${{ secrets.DO_REGISTRY }}/guardian-sentinel:${{ github.sha }}
          KUBECONFIG=./kubeconfig kubectl rollout status deployment/guardian-sentinel --timeout=120s
